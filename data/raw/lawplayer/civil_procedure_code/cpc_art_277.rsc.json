54:T1766,.lpp{font-family:var(--brand-font-sans,sans-serif);color:var(--brand-text);margin-block:1rem;letter-spacing:normal}
.lpp[hidden]{display:none}
.lpp__box{position:relative}
.lpp__text{min-width:0}
.lpp__eyebrow{display:block;margin:0 0 8px;font-size:12px;font-weight:600;line-height:1.5;letter-spacing:normal;color:#8A6511}
.lpp__status{display:inline-flex;align-items:center;width:max-content;height:24px;padding:0 10px;border-radius:6px;background:rgba(20,22,26,.82);font-size:11px;font-weight:700;letter-spacing:.04em;text-wrap:nowrap;backdrop-filter:blur(4px)}
.lpp__status--crowdfunding{color:#34D399;box-shadow:inset 0 0 0 1px rgba(52,211,153,.55),0 1px 2px rgba(0,0,0,.3)}
.lpp__status--countdown{color:#FF4D4D;box-shadow:inset 0 0 0 1px rgba(255,77,77,.6),0 1px 2px rgba(0,0,0,.3)}
.lpp__badge-text{display:block;line-height:1;text-box:trim-both cap alphabetic;transform:translateY(-.5px)}
.lpp__h{margin:0;color:#14161A;font-size:15px;font-weight:700;line-height:1.45;letter-spacing:normal;text-wrap:balance}
.lpp__sub{margin:8px 0 0;max-width:38em;color:#57534E;font-size:13px;font-weight:400;line-height:1.6;letter-spacing:normal;text-wrap:pretty}
.lpp__h,.lpp__sub{display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden}
.lpp__sub{-webkit-line-clamp:2;line-clamp:2}
.lpp__actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin:14px 0 0}
.lpp__cta{color:#8A6511;font-size:14px;font-weight:700;letter-spacing:normal;text-decoration:none;transition:opacity 200ms}
.lpp__cta:hover{text-decoration:underline;text-underline-offset:3px;opacity:.8}
.lpp__sec{font-size:13px;color:var(--brand-text-muted);text-decoration:none}
.lpp__sec:hover{text-decoration:underline}
.lpp__dismiss{margin-left:auto;border:0;background:none;padding:4px 6px;font-size:13px;color:var(--brand-text-muted);cursor:pointer;line-height:0;transition:opacity 200ms}
.lpp__dismiss:hover{opacity:.7}
.lpp__dismiss:focus-visible{outline:2px solid #8A6511;outline-offset:2px}
.lpp--line .lpp__line{display:flex;align-items:center;flex-wrap:wrap;gap:4px 8px;margin:0;line-height:1.6}
.lpp--line .lpp__eyebrow{display:inline-flex;margin:0}
.lpp--line .lpp__h{display:-webkit-box;min-width:0;font-size:14px;font-weight:600;line-height:1.6;-webkit-line-clamp:2;line-clamp:2}
.lpp--line .lpp__sub{display:inline;margin:0;max-width:none;font-size:13px}
.lpp--line .lpp__cta,.lpp--line .lpp__sec{margin-left:0}
.lpp--banner .lpp__box{display:flex;align-items:center;gap:20px;padding:16px 20px;border:1px solid rgba(213,191,151,.45);border-radius:12px;background:#FFFFFF;box-shadow:0 2px 12px rgba(20,22,26,.06)}
.lpp--banner .lpp__text{flex:1}
.lpp--banner .lpp__h{font-size:15px;line-height:1.45;-webkit-line-clamp:2;line-clamp:2}
.lpp--banner .lpp__actions{flex:none;margin:0}
.lpp--note .lpp__box,.lpp--card .lpp__box{padding:16px;border:1px solid rgba(213,191,151,.45);border-radius:16px;background:#FFFFFF;box-shadow:0 2px 12px rgba(20,22,26,.06)}
.lpp--card .lpp__h{font-size:16px;-webkit-line-clamp:3;line-clamp:3}
.lpp--note .lpp__h{font-size:15px;-webkit-line-clamp:2;line-clamp:2}
.lpp__items{list-style:none;margin:8px 0 0;padding:0}
.lpp__item{position:relative;padding-left:20px;font-size:14px;line-height:1.7;color:#374151}
.lpp__item::before{content:"";position:absolute;left:2px;top:.55em;width:5px;height:9px;border-right:2px solid #8A6511;border-bottom:2px solid #8A6511;transform:rotate(45deg)}
.lpp--banner .lpp__cta,.lpp--card .lpp__cta,.lpp--note .lpp__cta{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;border:0;border-radius:10px;background:linear-gradient(120deg,#F6EBD4 0%,#EDD9B4 38%,#F9F1E1 62%,#EDDCBC 100%);box-shadow:inset 0 1px 0 rgba(255,255,255,0.85),inset 0 -1px 0 rgba(118,100,69,0.28),0 1px 2px rgba(118,100,69,0.35);color:#3E3222;font-size:14px;font-weight:700;letter-spacing:normal;text-decoration:none;white-space:nowrap;transition:transform 200ms}
.lpp--banner .lpp__cta:hover,.lpp--card .lpp__cta:hover,.lpp--note .lpp__cta:hover{opacity:1;text-decoration:none;transform:translateY(-1px);filter:brightness(1.04);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),inset 0 -1px 0 rgba(118,100,69,.24),0 3px 8px rgba(118,100,69,.32)}
.lpp--banner .lpp__cta:active,.lpp--card .lpp__cta:active,.lpp--note .lpp__cta:active{transform:translateY(0);filter:brightness(.97);box-shadow:inset 0 2px 4px rgba(118,100,69,.35),0 1px 2px rgba(118,100,69,.25)}
.lpp--banner .lpp__cta:focus-visible,.lpp--card .lpp__cta:focus-visible,.lpp--note .lpp__cta:focus-visible{outline:2px solid #8A6511;outline-offset:2px}
.lpp__box .lpp__dismiss{position:absolute;top:8px;right:8px;margin:0;display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;padding:0;border-radius:999px}
.lpp--banner .lpp__box:has(.lpp__dismiss),.lpp--note .lpp__box:has(.lpp__dismiss),.lpp--card .lpp__box:has(.lpp__dismiss){padding-right:40px}
.lpp[data-lpa-dismissed]{opacity:0;transform:translateY(-4px);transition:opacity 240ms,transform 240ms}
html[data-lp-ent~="feature:tw:search-pro"] .lpp[data-lpa-product="law-sub"]{display:none}
html[data-lp-ent~="feature:tw:law-content"] .lpp[data-lpa-product="law-sub"]{display:none}
html[data-lp-ent~="feature:tw:company"] .lpp[data-lpa-product="company-sub"]{display:none}
html[data-lp-ent~="feature:tw:tools"] .lpp[data-lpa-product="tools-sub"]{display:none}
html[data-lp-ent~="feature:tw:search-pro"] .lpp[data-lpa-product="tools-sub"]{display:none}
@media (max-width:767px){.lpp--line .lpp__sub{display:none}.lpp--banner .lpp__box{display:grid;grid-template-columns:minmax(0,1fr);gap:14px;padding:16px}.lpp--banner .lpp__actions{width:100%}.lpp--banner .lpp__cta,.lpp--card .lpp__cta,.lpp--note .lpp__cta{width:100%}.lpp--banner .lpp__box:has(.lpp__dismiss),.lpp--note .lpp__box:has(.lpp__dismiss),.lpp--card .lpp__box:has(.lpp__dismiss){padding-right:40px}}
